<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- Allows high frame rate rendering on ProMotion displays -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>

	<!-- Required for AVPictureInPictureController on real devices.
	     Without this, isPictureInPictureSupported() returns false. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- Previously generated by INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents -->
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- Previously generated by INFOPLIST_KEY_UILaunchScreen_Generation -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchScreenBackground</string>
	</dict>

	<!-- Previously generated by INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- Camera and microphone usage descriptions — required for AVFoundation camera access -->
	<key>NSCameraUsageDescription</key>
	<string>Camera access is used to record video of your teleprompter performance.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Microphone access is optionally used to include audio in your recorded teleprompter video.</string>

	<!-- Previously generated by INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Photos library usage descriptions — required to save recorded videos to the camera roll -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Photo library access is required to save your recorded teleprompter videos to the Photos app.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Photo library access is required to save your recorded teleprompter videos to the Photos app.</string>
</dict>
</plist>
