    <string name="help_mirror">Lustro — Włącz natychmiastowe odwrócenie tekstu dla urządzeń teleprompter.</string>
    <string name="help_overlay">Nakładka — Utrzymuj swój skrypt widocznym w pływającym oknie (PiP).</string>

