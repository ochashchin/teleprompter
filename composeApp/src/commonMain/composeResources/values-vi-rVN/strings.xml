    <!-- ── Mock Data ────────────────────────────────────────────────────── -->
    <string name="seed_task1_title">Vlog du lịch</string>
    <string name="seed_task1_desc">Cùng khám phá những điểm đến bí ẩn, ẩm thực địa phương và trải nghiệm khó quên trên khắp thế giới.\n\nTrải nghiệm văn hóa qua lăng kính người bản xứ.\n\nThưởng thức món ăn tuyệt vời và khám phá những câu chuyện thú vị.\n\nCuộc phiêu lưu chờ đợi ở khắp mọi nơi.</string>
    <string name="seed_task1_spans">0|13|1|0|0|-1;58|69|1|1|1|0;100|111|1|0|0|1;149|160|1|0|0|2;216|230|1|0|0|3</string>
    <string name="seed_task2_title">Podcast năng suất</string>
    <string name="seed_task2_desc">Hôm nay chúng ta sẽ thảo luận về sự tập trung, thói quen và các chiến lược thiết thực để làm được nhiều việc hơn mà không bị kiệt sức.\n\nChúng ta sẽ xem xét những thói quen nhỏ tạo ra sự khác biệt lớn khi được thực hành nhất quán.\n\nBạn sẽ học cách ưu tiên những gì quan trọng, quản lý sự phân tâm và bảo vệ năng lượng của bạn trong suốt cả ngày.\n\nĐến cuối cùng, bạn sẽ có một khuôn khổ đơn giản mà bạn có thể điều chỉnh cho công việc và lối sống của riêng mình.</string>
    <string name="seed_task2_spans">0|7|1|0|0|-1;122|133|1|1|1|0;136|155|1|0|0|1;231|246|1|0|0|2;346|359|1|0|0|3</string>
    <string name="seed_task3_title">Livestream cộng đồng</string>
    <string name="seed_task3_desc">Cảm ơn vì đã tham gia buổi phát trực tiếp hôm nay. Chúng ta sẽ trò chuyện, trả lời các câu hỏi và xem qua những cập nhật mới nhất.\n\nChúng ta sẽ điểm qua những điểm nổi bật, chia sẻ một vài chi tiết hậu trường và khám phá những gì sắp tới.\n\nĐừng ngần ngại đặt câu hỏi và suy nghĩ của bạn trong phần trò chuyện khi chúng ta tiếp tục.\n\nHãy bắt đầu và làm cho buổi này trở nên tương tác.</string>
    <string name="seed_task3_spans">0|21|1|0|0|-1;112|129|1|1|1|0;132|152|1|0|0|1;240|254|1|0|0|2;333|344|1|0|0|3</string>
    <string name="seed_task4_title">Phát trực tiếp</string>
    <string name="seed_task4_desc">Chào mừng mọi người đến với buổi phát trực tiếp hôm nay! Chúng ta sẽ đề cập đến các bản cập nhật, trả lời các câu hỏi từ cuộc trò chuyện và chia sẻ những gì sắp tới.\n\nCho dù bạn đang tham gia cùng chúng tôi trực tiếp hay xem lại sau, chúng tôi rất vui vì có bạn ở đây.\n\nĐừng ngần ngại đặt câu hỏi của bạn trong cuộc trò chuyện và tham gia vào cuộc trò chuyện.\n\nHãy đi sâu vào và bắt đầu.</string>
    <string name="seed_task4_spans">0|19|1|0|0|-1;148|164|1|1|1|0;167|216|1|0|0|1;270|284|1|0|0|2;361|375|1|0|0|3</string>
