    <string name="help_transition">Chuyển tiếp — Chọn hiệu ứng: Không có, Mờ dần hoặc In.</string>
    <string name="help_distortion">Biến dạng — Chọn góc chống biến dạng: 0°, 45° hoặc 70°.</string>
