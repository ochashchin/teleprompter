    <string name="help_text_size">Cỡ chữ — Chọn cỡ chữ từ Nhỏ đến Đồ sộ để đọc thoải mái.</string>
    <string name="help_orientation">Hướng — Chọn hướng đọc: Dọc hoặc Ngang để có góc nhìn rộng hơn.</string>
    <string name="help_speed">Tốc độ — Chọn nhịp độ nói: từ Chậm đến Nhanh cho tự nhiên.</string>
