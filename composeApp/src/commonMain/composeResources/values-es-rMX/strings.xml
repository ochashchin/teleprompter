    <string name="help_bold">Negrita — Enfatiza palabras importantes, títulos o puntos clave.</string>
    <string name="help_italic">Cursiva — Marca notas, indicaciones o frases que requieran un tono distinto.</string>
    <string name="help_underline">Subrayado — Resalta información crítica que no debe pasarse por alto.</string>
    <string name="help_text_color">Color del texto — Elige un color de la paleta para enfatizar el texto u organizar visualmente tu guion.</string>
    <string name="help_fill_color">Color de relleno — Elige un color de fondo para mejorar la comodidad y el contraste.</string>
    <string name="help_text_size">Tamaño del texto — Selecciona un tamaño desde Pequeño hasta Masivo para una lectura cómoda.</string>
    <string name="help_orientation">Orientación — Selecciona la dirección de lectura: Vertical u Horizontal para una vista más amplia.</string>
    <string name="help_speed">Velocidad — Selecciona un ritmo de habla: de Lenta a Rápida para una presentación natural.</string>
    <string name="help_animation">Animación — Selecciona un estilo de lectura. Bucle disponible.</string>
    <string name="help_transition">Transición — Selecciona efectos visuales: Ninguna, Desvanecimiento o Impresión.</string>
    <string name="help_distortion">Distorsión — Selecciona la perspectiva antidistorsión: 0°, 45° o 70°.</string>
    <string name="help_mirror">Espejo — Habilita la inversión instantánea del texto para dispositivos teleprompter.</string>
    <string name="help_overlay">Superposición — Mantén tu guion visible durante la grabación con la cámara o en una ventana flotante PiP sobre outras aplicaciones.</string>

