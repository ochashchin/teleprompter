    <!-- ── Help strings ────────────────────────────────────────────────── -->
    <string name="help_bold">Kalın — Önemli kelimeleri, başlıkları veya kilit noktaları vurgulayın.</string>
    <string name="help_italic">İtalik — Farklı bir ton gerektiren notları, ipuçlarını veya ifadeleri işaretleyin.</string>
    <string name="help_underline">Altı çizili — Göz ardı edilmemesi gereken kritik bilgileri vurgulayın.</string>
    <string name="help_text_color">Metin Rengi — Metni vurgulamak veya senaryonuzu görsel olarak düzenlemek için paletten bir renk seçin.</string>
    <string name="help_fill_color">Dolgu Rengi — Konforu ve kontrastı artırmak için arka plan rengi seçin.</string>
    <string name="help_text_size">Metin Boyutu — Rahat bir okuma için Küçükten Devasaya kadar bir boyut seçin.</string>
    <string name="help_orientation">Yön — Okuma yönünü seçin: Daha geniş bir görünüm için Dikey veya Yatay.</string>
    <string name="help_speed">Hız — Konuşma ritmini seçin: doğal bir akış için Yavaştan Hızlıya.</string>
    <string name="help_animation">Animasyon — Okuma stilini seçin. Döngü mevcuttur.</string>
    <string name="help_transition">Geçiş — Görsel efektleri seçin: Yok, Solma veya Yazdırma.</string>
    <string name="help_distortion">Bozulma — Bozulma önleyici perspektifi seçin: 0°, 45° veya 70°.</string>
    <string name="help_mirror">Ayna — Yansıtıcı teleprompter cihazları için metni anında ters çevirin.</string>
    <string name="help_overlay">Yer Paylaşımı — Diğer uygulamaları kullanırken senaryonuzu yüzen bir pencerede görünür tutun.</string>

