    <!-- ── Mock Data ────────────────────────────────────────────────────── -->
    <string name="seed_task1_title">यात्रा व्लॉग</string>
    <string name="seed_task1_desc">मेरे साथ जुड़ें क्योंकि हम दुनिया भर के छिपे हुए स्थानों, स्थानीय भोजन और अविस्मरणीय अनुभवों का पता लगाते हैं।\n\nस्थानीय लोगों की नज़र से संस्कृतियों का अनुभव करें।\n\nअविश्वसनीय व्यंजनों का स्वाद लें और उल्लेखनीय कहानियों को उजागर करें।\n\nहर कोने में रोमांच इंतजार कर रहा है।</string>
    <string name="seed_task1_spans">0|15|1|0|0|-1;85|92|1|1|1|0;152|162|1|0|0|1;188|197|1|0|0|2;248|254|1|0|0|3</string>
    <string name="seed_task2_title">उत्पादकता पॉडकास्ट</string>
    <string name="seed_task2_desc">आज हम फोकस, रूटीन और बिना थके अधिक काम करने की व्यावहारिक रणनीतियों पर चर्चा कर रहे हैं।\n\nहम छोटी आदतों पर नज़र डालेंगे जो लगातार अभ्यास करने पर बड़ा अंतर लाती हैं।\n\nआप सीखेंगे कि क्या मायने रखता है इसे कैसे प्राथमिकता दें, ध्यान भटकाने वाली चीजों को कैसे प्रबंधित करें और पूरे दिन अपनी ऊर्जा की रक्षा कैसे करें।\n\nअंत तक, आपके पास एक सरल ढांचा होगा जिसे आप अपने काम और जीवन शैली के अनुकूल बना सकते हैं।</string>
    <string name="seed_task2_spans">0|2|1|0|0|-1;21|29|1|1|1|0;166|176|1|0|0|2;314|320|1|0|0|3</string>
    <string name="seed_task3_title">कम्युनिटी लाइवस्ट्रीम</string>
    <string name="seed_task3_desc">आज की स्ट्रीम में शामिल होने के लिए धन्यवाद। हम चैट करेंगे, सवालों के जवाब देंगे और नवीनतम अपडेट पर पहली नज़र डालेंगे।\n\nहम मुख्य बातों पर चर्चा करेंगे, पर्दे के पीछे के कुछ विवरण साझा करेंगे और देखेंगे कि आगे क्या आ रहा है।\n\nकृपया अपने सवाल और विचार चैट में छोड़ दें जैसे हम आगे बढ़ते हैं।\n\nचलिए शुरू करते हैं और इस सत्र को इंटरैक्टिव बनाते हैं।</string>
    <string name="seed_task3_spans">18|43|1|0|0|-1;84|96|1|1|1|0;225|230|1|0|0|2;291|309|1|0|0|3</string>
    <string name="seed_task4_title">लाइव स्ट्रीम</string>
    <string name="seed_task4_desc">आज की स्ट्रीम में सभी का स्वागत है! हम अपडेट को कवर करेंगे, चैट से सवालों के जवाब देंगे और साझा करेंगे कि आगे क्या आ रहा है।\n\nचाहे आप हमारे साथ लाइव जुड़ रहे हों या बाद में देख रहे हों, हम आपको यहाँ पाकर उत्साहित हैं।\n\nकृपया अपने प्रश्न चैट में छोड़ दें और बातचीत में शामिल हों।\n\nचलिए गहराई में जाते हैं और शुरू करते हैं।</string>
    <string name="seed_task4_spans">18|34|1|0|0|-1;106|123|1|1|1|0;126|161|1|0|0|1;219|224|1|0|0|2;280|303|1|0|0|3</string>
    <string name="seed_task5_title">इनलाइन प्रोमो</string>
    <string name="seed_task5_desc">पढ़ें • रिकॉर्ड करें • प्रकाशित करें • दोहराएं • केंद्रित रहें • प्राकृतिक आवाज दें • आत्मविश्वास के साथ बनाएं</string>
