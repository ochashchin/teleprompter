    <!-- ── Help strings ────────────────────────────────────────────────── -->
    <string name="help_bold">太字 — 重要な単語、見出し、または重要なポイントを強調します。</string>
    <string name="help_italic">斜体 — 異なるトーンを必要とするメモやフレーズをマークします。</string>
    <string name="help_underline">下線 — 見逃してはならない重要な情報を強調します。</string>
    <string name="help_text_color">テキストの色 — パレットから色を選択してテキストを強調します。</string>
    <string name="help_fill_color">塗りつぶしの色 — 快適さとコントラストを向上させるために背景色を選択します。</string>
    <string name="help_text_size">テキストサイズ — 快適な読み取りのためにサイズを選択します。</string>
    <string name="help_orientation">方向 — 読み取り方向（縦または横）を選択します。</string>
    <string name="help_speed">速度 — 話すリズム（遅いから速いまで）を選択します。</string>
    <string name="help_animation">アニメーション — 読み取りスタイルを選択します。ループも可能です。</string>
    <string name="help_transition">トランジション — 視覚効果（なし、フェード、プリント）を選択します。</string>
    <string name="help_distortion">歪み — 歪み防止パースペクティブ（0°、45°、70°）を選択します。</string>
    <string name="help_mirror">ミラー — テレプロンプター用にテキストを瞬時に反転します。</string>
    <string name="help_overlay">オーバーレイ — スクリプトをフローティング（PiP）ウィンドウで表示し続けます。</string>

