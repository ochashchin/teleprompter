    <!-- ── Help strings ────────────────────────────────────────────────── -->
    <string name="help_bold">Bold — Emphasize important words, headings, or key talking points.</string>
    <string name="help_italic">Italic — Mark notes, cues, or phrases that require a different tone or emphasis.</string>
    <string name="help_underline">Underline — Highlight critical information that should not be overlooked.</string>
    <string name="help_text_color">Text Color — Choose a color from the palette to emphasize selected text or organize your script visually.</string>
    <string name="help_fill_color">Fill Color — Choose a color from the palette to highlight page background color to improve comfort and contrast.</string>
    <string name="help_text_size">Text Size — Select a text size from Small to Massive for comfortable reading.</string>
    <string name="help_orientation">Orientation — Select a reading direction: Vertical or Horizontal for a wider view.</string>
    <string name="help_speed">Speed — Select a speaking rhythm: from Slow to Fast for natural delivery.</string>
    <string name="help_animation">Animation — Select a reading style: Frame-by-frame, vertical Scroll, and horizontal Inline for readability. Looping available.</string>
    <string name="help_transition">Transition — Select visual effects: None for distraction-free, Fade for memory and pacing, or Print for focus and synchronizations.</string>
    <string name="help_distortion">Distortion — Select anti-distortion perspective: 0°, 45°, or 70° for a smoother off-angle reading.</string>
    <string name="help_mirror">Mirror — Enable instant reverse the text for reflective teleprompter rigs.</string>
    <string name="help_overlay">Overlay — Keep your script visible during camera recording or in a floating PiP window over other apps.</string>

