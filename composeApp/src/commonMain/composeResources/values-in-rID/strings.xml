    <!-- ── Help strings ────────────────────────────────────────────────── -->
    <string name="help_bold">Tebal — Tekankan kata-kata penting, judul, atau poin utama.</string>
    <string name="help_italic">Miring — Tandai catatan, isyarat, atau frasa yang memerlukan nada atau penekanan yang berbeda.</string>
    <string name="help_underline">Garis Bawah — Soroti informasi penting yang tidak boleh terlewatkan.</string>
    <string name="help_text_color">Warna Teks — Pilih warna dari palet untuk menekankan teks atau mengatur skrip Anda.</string>
    <string name="help_fill_color">Warna Isi — Pilih warna latar belakang untuk meningkatkan kenyamanan dan kontras.</string>
    <string name="help_text_size">Ukuran Teks — Pilih ukuran dari Kecil hingga Masif untuk bacaan yang nyaman.</string>
    <string name="help_orientation">Orientasi — Pilih arah: Vertikal atau Horizontal untuk pandangan yang lebih luas.</string>
    <string name="help_speed">Kecepatan — Pilih ritme berbicara: dari Lambat hingga Cepat untuk penyampaian yang alami.</string>
    <string name="help_animation">Animasi — Pilih gaya membaca: Bingkai demi bingkai, Gulir vertikal, dan Sebaris. Mode ulangi tersedia.</string>
    <string name="help_transition">Transisi — Pilih efek visual: Tidak ada, Pudar, atau Cetak untuk sinkronisasi.</string>
    <string name="help_distortion">Distorsi — Pilih perspektif anti-distorsi: 0°, 45°, atau 70°.</string>
    <string name="help_mirror">Cermin — Balikkan teks secara instan untuk perangkat teleprompter reflektif.</string>
    <string name="help_overlay">Hamparan — Jaga agar skrip tetap terlihat di jendela PiP mengambang.</string>

