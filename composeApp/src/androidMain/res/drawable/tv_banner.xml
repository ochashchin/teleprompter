<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Red Background shape with explicit 16:9 intrinsic dimensions -->
    <item
        android:width="320dp"
        android:height="180dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF0000" />
        </shape>
    </item>

    <!-- Foreground Logo (scaled up 1.5x to 270dp x 270dp and centered using symmetric offsets) -->
    <item
        android:drawable="@drawable/ic_launcher_foreground"
        android:left="25dp"
        android:right="25dp"
        android:top="-45dp"
        android:bottom="-45dp" />
</layer-list>
